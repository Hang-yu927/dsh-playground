# Unity 项目 .gitignore (来源: github/gitignore - Unity.gitignore)
# 放置于 Unity 项目根目录（与 Assets、ProjectSettings 同级）

# Unity 生成的目录
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 资源对应的 meta 文件不应被忽略（仅当资源本身被忽略时才忽略）
!/[Aa]ssets/**/*.meta

# Asset Store 插件可按需取消注释
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider 自动生成的插件
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio 缓存
.vs/
.idea/

# Gradle 缓存
.gradle/

# IDE 生成的工程文件
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 生成的 meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 崩溃报告
sysinfo.txt

# 打包产物
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables 打包数据
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Android 临时生成资源
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
